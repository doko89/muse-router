# muse-router: OpenAI/Anthropic-compatible router di atas Muse Code subscription.
# Salin ke .env lalu sesuaikan. Semua kredensial cukup via ENV atau file.

# Alamat listen HTTP.
ROUTER_BIND=127.0.0.1:4000

# Bearer token router (koma-pisah). Kosong = tanpa auth, hanya untuk dev lokal.
ROUTER_API_KEYS=sk-router-ganti-saya

# Kredensial Muse Code (JSON dari `muse-router login`).
# MUSE_CREDENTIAL_JSON={"oauthAccessToken":"...","apiKey":"LLM|..."}

# File kredensial Muse Code (dibaca bila JSON di atas kosong; ditulis oleh login).
# MUSE_CREDENTIAL_FILE=~/.muse-router/credential.json

# Alternatif: token akun Meta untuk auto-mint api key (tanpa file/JSON).
# MUSE_OAUTH_TOKEN=

# Alternatif: langsung pakai Model API key (tanpa mint/refresh).
# MUSE_API_KEY=

# Endpoint upstream (default di bawah; jarang perlu diubah).
# MUSE_BASE_URL=https://api.meta.ai/v1
# MUSE_KEY_URL=https://api.meta.ai/muse-code/key
# MUSE_DEVICE_AUTH_URL=https://auth.meta.com/oidc/device/authorization/
# MUSE_DEVICE_TOKEN_URL=https://auth.meta.com/oidc/device/token/
# MUSE_DEVICE_CLIENT_ID=1031625952748946

# Simpan run di sisi Meta (store:true) bila klien tidak menentukan. Default 0.
# MUSE_STORE_RESPONSES=0

# Batas tunggu header/first-byte upstream dalam detik (turn reasoning lama).
# MUSE_TIMEOUT_SECONDS=600
